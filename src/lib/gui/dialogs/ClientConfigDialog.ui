    <widget class="QCheckBox" name="cbDynamicConnectTime">
     <property name="toolTip">
      <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Allow the client to slow the rate it attempts to reconnect to the server when connections attempts are failing. The delay between connection attempts will  start at 1 second intervals and can be a maxium of 5 minutes between connection attempts.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
     </property>
     <property name="text">
      <string>Use dynamic reconnection time based on connection attempts</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="cbLanguageSync">
     <property name="text">
      <string>Use server's keyboard language on this computer</string>
     </property>
    </widget>
   </item>
   <item>
    <widget class="QCheckBox" name="cbPhysicalKeys">
     <property name="toolTip">
      <string>macOS client with a Windows server only. Keys from the server keyboard keep their physical position and type the Windows characters of this Mac's current input language. Windows editing keys (Ctrl+Backspace, Ctrl+Delete, Ctrl+Arrows, Home, End, Ctrl+Y) get their macOS equivalents. This Mac's own keyboard is not affected. Language sync has no effect in this mode.</string>
     </property>
     <property name="text">
      <string>Windows server keyboard (physical keys)</string>
     </property>
    </widget>
   </item>
