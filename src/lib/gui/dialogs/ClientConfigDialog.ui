     <item>
      <widget class="QCheckBox" name="cbAltTab">
       <property name="toolTip">
        <string>Server Alt+Tab opens the macOS app switcher (Command+Tab). Command stays held while Alt is held, so the switcher shortcuts (arrows, Q, H) work. Needs the Windows server keyboard.</string>
       </property>
       <property name="text">
        <string>Alt+Tab switches apps</string>
       </property>
